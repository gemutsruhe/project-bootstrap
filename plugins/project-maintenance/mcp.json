{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "project-maintenance": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/server/dist/index.js",
        "--server-name",
        "project-maintenance",
        "--server-version",
        "0.3.2"
      ],
      "cwd": "${PLUGIN_ROOT}",
      "env_vars": [
        "PROJECT_MAINTENANCE_ALLOWED_ROOT"
      ]
    }
  }
}
