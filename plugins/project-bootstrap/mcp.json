{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "project-bootstrap": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/server/dist/index.js"
      ],
      "cwd": "${PLUGIN_ROOT}",
      "env_vars": [
        "PROJECT_BOOTSTRAP_ALLOWED_ROOT"
      ]
    }
  }
}
